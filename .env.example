# MySQL (cPanel → MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Signs admin session cookies — 32+ random characters
SESSION_SECRET=

# First admin account, created on boot only if no admin exists yet.
# Remove ADMIN_PASSWORD after the first start.
ADMIN_EMAIL=admin@legrandehaven.co.ke
ADMIN_PASSWORD=

# M-Pesa STK push (Safaricom Daraja). Set these in cPanel → Setup Node.js App →
# Environment variables. Never commit real values — the repo is public.
# Sandbox: shortcode 174379, CustomerPayBillOnline (test money only).
# Live till: after Daraja "Go Live", use the store number as MPESA_SHORTCODE,
#   MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline and MPESA_PARTY_B=4323604.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=
# Optional — defaults to https://<site>/api/mpesa/callback
MPESA_CALLBACK_URL=
